rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // The club admin: users/{uid}.role == 'admin'.
    //
    // FAILS CLOSED. No users document, no role field, or any value other
    // than the exact string 'admin' is not an admin. exists() first, so a
    // missing document is a plain false rather than an evaluation error.
    //
    // Only safe because clients cannot write their own role — see
    // match /users/{uid}. Every rule below that calls this depends on that.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // ─── Existing collections ─────────────────────────────────────────────────

    // ── athletes/{athleteId} — the club's PUBLIC athlete profile ──────────
    // Readable by anyone, signed out included: the club site's athletes,
    // rankings, records and competition pages read it directly. So it may
    // hold only what a WCA-style public profile shows — name, photo
    // (imageUrl), WCA id — plus the ownerId link the profile page's claim
    // picker filters on.
    //
    // Date of birth and phone live in athletes/{athleteId}/private/identity
    // (lib/firebase/services/athletes.ts). Rules cannot hide one field of a
    // readable document, so a split is the only way to keep them private.
    // The public write rule refuses both keys, so no client — an old tab
    // included — can put one back. scripts/move-athlete-private-fields.mjs
    // moves the existing values across; it must run BEFORE these rules are
    // deployed, or an admin edit of an unmoved athlete is refused.
    match /athletes/{athleteId} {
      function athletePrivateKeys() {
        return ['birthDate', 'phone'];
      }

      allow read: if true;
      allow create, update: if isAdmin() &&
                               !request.resource.data.keys().hasAny(athletePrivateKeys());
      allow delete: if isAdmin();

      // Admins, and the signed-in account this athlete is linked to (ownerId,
      // set by the admin link or an approved claim). Nobody else — not even
      // an account that owns a DIFFERENT athlete. A missing parent makes
      // get() an error, which denies.
      match /private/{docId} {
        allow read: if isAdmin() ||
                       (isSignedIn() &&
                        get(/databases/$(database)/documents/athletes/$(athleteId)).data.get('ownerId', null) == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    match /competitions/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /results/{doc} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── users/{uid} — the club account ───────────────────────────────────
    // `role` is what isAdmin() reads, so NO CLIENT MAY GRANT ITSELF A ROLE.
    // This used to be `allow write: if request.auth.uid == uid`: any
    // signed-in user could set role: 'admin' on their own document and then
    // approve their own submissions, delete rivals', and read every draft.
    //
    // What each client write may do now:
    //   create — only your own document, and only as 'member' (or with no
    //            role). That is exactly what auth-context's first-sign-in
    //            upsert writes.
    //   update — your own document, any field EXCEPT role (the sign-in
    //            refresh, the profile edit, every points.ts transaction);
    //            or, as an admin, any user's document including role (the
    //            club admin's UsersTab: role change, points, athlete link).
    //   delete — your own document, or any as an admin. Deleting your own
    //            and re-creating it can only land you back on 'member'.
    //
    // READ — your own document, or any as an admin. This was isSignedIn():
    // every account's email was readable by every other account. Nothing
    // legitimate reads someone else's: auth-context, the timer profile and
    // points.ts read their own; UsersTab, the admin dashboard and a claim
    // approval (awardAthleteLinked) run as an admin; match history takes each
    // player's avatar from the multiplayer room instead.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.auth.uid == uid &&
                       (!('role' in request.resource.data) || request.resource.data.role == 'member');
      allow update: if isSignedIn() &&
                       ((request.auth.uid == uid &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
                        isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /assignments/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wcaRecords/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /athleteRequests/{doc} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /matchHistory/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /pointTransactions/{doc} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    // ─── Virtual Competitions ─────────────────────────────────────────────────

    match /virtualCompetitions/{compId} {
      allow read: if isAdmin() ||
                     !('status' in resource.data) ||
                     resource.data.status != 'draft';
      allow write: if isAdmin();

      match /rounds/{roundId} {
        allow read: if isAdmin() ||
                       !('status' in get(/databases/$(database)/documents/virtualCompetitions/$(compId)).data) ||
                       get(/databases/$(database)/documents/virtualCompetitions/$(compId)).data.status != 'draft';
        allow write: if isAdmin();
      }

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      }

      match /participantResults/{resultId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == resultId.split('_')[0];
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /attempts/{attemptId} {
        allow read: if isSignedIn() &&
                       (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow delete: if isAdmin();

        match /results/{resultId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if isAdmin();
        }
      }
    }

    match /{path=**}/attempts/{attemptId} {
      allow read: if isSignedIn() &&
                     (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /{path=**}/results/{resultId} {
      allow read: if isSignedIn();
    }

    // ─── Online Competition (public, isolated) ─────────────────────────────

    match /onlineCompetitions/{competitionId} {
      // Drafts are private: a competition is created as a draft and must
      // not be reachable — by list OR by direct id — until an admin moves
      // it on.
      //
      // Modelled on the virtualCompetitions block above but deliberately
      // NOT identical to it. That one reads
      //     isAdmin() || !('status' in resource.data) || status != 'draft'
      // and the middle clause silently defeats the whole guard on list
      // queries: because the rule permits documents that lack the field,
      // Firestore can no longer statically prove an UNFILTERED query is
      // safe — and rather than refusing it, it allows the query and
      // returns the drafts. Verified against the emulator: with that
      // clause present, an anonymous getDocs() of the whole collection
      // succeeds and includes every draft. (virtualCompetitions still has
      // this hole — see the note in tests/firestore-rules/README.md.)
      //
      // Dropping the clause is what makes the guard real, at one cost: a
      // doc with NO `status` field at all is now unreadable to clients
      // (it fails `resource.data.status != 'draft'` outright) rather than
      // being treated as public. Every doc toFirestoreDoc writes has a
      // status and the type declares it required, so this is theoretical;
      // and it changes nothing for the public LIST either way, since the
      // inequality filter that list must use already skips field-less
      // docs. Test 8 in competitions.test.mjs pins this trade-off.
      //
      // The `isAdmin()` disjunct is the club's Firebase Auth admin. The
      // online-competition judges do not use it — they are a shared
      // password, not an auth identity — but it is NOT dead: a club admin
      // passes it with the client SDK. It was self-grantable until
      // users/{uid}.role was locked against client writes; it is kept so a
      // club admin is never locked out of a collection they can already
      // write.
      //
      // Hiding drafts at the rules layer WORKS regardless, because the
      // online-competition admin UI never reads this collection through
      // the client SDK: it goes via the admin-cookie-gated
      // /api/online-competition/admin-competitions routes, which use the
      // Admin SDK and bypass rules entirely. The admin still sees every
      // draft while no client can.
      //
      // Consequence for callers: a list query here is allowed only if it
      // PROVES it excludes drafts, e.g. where('status', '!=', 'draft')
      // (what fetchAllCompetitions issues). An unfiltered getDocs() fails.
      allow read: if isAdmin() || resource.data.status != 'draft';
      allow write: if isAdmin();

      match /scrambles/{scrambleId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      // Official imported scrambles + snake-seeded group assignments
      // (app/online-competition/admin/scrambles). Written and read
      // exclusively by the Admin SDK from admin-cookie-gated API routes
      // — the online-competition admin is a shared password, not a
      // Firebase Auth identity, so there is no request.auth for a rule
      // here to check. Denied to every client: reading scrambleData
      // directly would hand an athlete every group's scrambles before
      // they solve. Explicit rather than relying on the default deny.
      match /scrambleData/{roundId} {
        allow read, write: if false;
      }
      match /groupAssignments/{roundId} {
        allow read, write: if false;
      }

      // Round state + qualifier lists (app/online-competition/admin/rounds).
      // Same reasoning as the two above: written only by the Admin SDK from
      // admin-cookie-gated routes, and read server-side when gating a solve.
      // Denied to clients so an athlete can't read who qualified — or, worse,
      // mark themselves qualified.
      match /roundState/{roundId} {
        allow read, write: if false;
      }
      match /qualifiers/{roundId} {
        allow read, write: if false;
      }

      // Run tickets (lib/online-competition/scramble-gate.ts): written by
      // the scramble route, with the Admin SDK, each time it serves an
      // attempt — { uid, eventId, competitionRound, servedThrough }. The
      // onlineSubmissions create rule below requires one. Denied to every
      // client: a ticket an athlete could write would be a round they
      // could file into.
      match /runTickets/{ticketId} {
        allow read, write: if false;
      }
    }

    match /onlineParticipants/{uid} {
      function priorProfileStatus() {
        return (resource == null || !('profileStatus' in resource.data))
          ? 'incomplete'
          : resource.data.profileStatus;
      }

      // The identity an admin actually reviews. Changing any of these
      // invalidates a prior approval, so a write that touches one must
      // also carry a legal profileStatus transition (see below).
      // NOTE `photoUrl` (the submitted verification photo) is NOT
      // `photoURL` (the Google avatar the sign-in upsert syncs) — the
      // casing is the whole difference and only the former is reviewed.
      function reviewedIdentityKeys() {
        return ['lastName', 'firstName', 'dateOfBirth', 'gender', 'citizenship', 'photoUrl'];
      }

      // Does this write ADD, CHANGE or REMOVE a reviewed identity field?
      // affectedKeys() is the diff, so a merge write that merely carries
      // an unchanged value forward does not count as touching it.
      function touchesReviewedIdentity() {
        return resource == null
          ? request.resource.data.keys().hasAny(reviewedIdentityKeys())
          : request.resource.data.diff(resource.data).affectedKeys().hasAny(reviewedIdentityKeys());
      }

      // ── Which profileStatus values a client may produce ─────────────
      //
      // Every client write here is a merge/update, so request.resource.data
      // is the FULL resulting document: an existing profileStatus is
      // carried forward whether the client mentioned it or not. Rules
      // therefore CANNOT distinguish "explicitly wrote 'approved'" from
      // "left the existing 'approved' alone". What they can do is forbid
      // the value from CHANGING to approved, which is the only case that
      // grants anything — see the note above `allow create, update`.
      //
      // Three ways to pass:
      //   1. profileStatus absent entirely (a doc that has never had one),
      //      allowed only if no reviewed identity field is being touched;
      //   2. 'incomplete', or 'pending' from any prior status — the
      //      submit / resubmit path, including an approved athlete
      //      re-submitting an edited profile, which correctly drops them
      //      back into the review queue;
      //   3. unchanged from its prior value AND touching no reviewed
      //      identity field — the sign-in upsert, which rewrites
      //      displayName / photoURL / email and nothing reviewable.
      function profileStatusTransitionAllowed() {
        return !('profileStatus' in request.resource.data)
          ? !touchesReviewedIdentity()
          : (request.resource.data.profileStatus == 'incomplete' ||
             request.resource.data.profileStatus == 'pending' ||
             (request.resource.data.profileStatus == priorProfileStatus() &&
              !touchesReviewedIdentity()));
      }

      // Admin-owned fields. An admin (or the admin-triggered recompute)
      // writes these through the Admin SDK, which bypasses rules
      // entirely; a client may never introduce, change, or erase them.
      // `stats` is the per-athlete PR/Ao5/solve-count rollup written by
      // lib/online-competition/athleteStats.ts — without it here a client
      // could set its own personal bests through the profile form, which
      // is a merge write and therefore carries the whole document.
      //
      // Requiring them to be ABSENT was wrong: every client write here is
      // a setDoc(..., { merge: true }), so request.resource.data is the
      // FULL resulting document and carries forward whatever the admin
      // last wrote. Comparing each field against its prior value locks
      // them down just as tightly while letting an untouched
      // carry-forward through.
      //
      // map.get(field, null) rather than an `in` test so all cases
      // collapse to one comparison: absent==absent passes, unchanged
      // passes, and introducing, changing OR erasing the field all fail.
      //
      // The approved* set records the identity an admin ACTUALLY reviewed,
      // so a later edit can never retroactively change what was approved.
      // approvedPhotoUrl has always done this for the photo; the name,
      // birth date, gender and citizenship now do the same.
      function judgeFieldsUntouched() {
        return resource == null
          ? (!('approvedPhotoUrl' in request.resource.data) &&
             !('approvedLastName' in request.resource.data) &&
             !('approvedFirstName' in request.resource.data) &&
             !('approvedDateOfBirth' in request.resource.data) &&
             !('approvedGender' in request.resource.data) &&
             !('approvedCitizenship' in request.resource.data) &&
             !('reviewedAt' in request.resource.data) &&
             !('rejectionReason' in request.resource.data) &&
             !('stats' in request.resource.data))
          : (request.resource.data.get('approvedPhotoUrl', null) == resource.data.get('approvedPhotoUrl', null) &&
             request.resource.data.get('approvedLastName', null) == resource.data.get('approvedLastName', null) &&
             request.resource.data.get('approvedFirstName', null) == resource.data.get('approvedFirstName', null) &&
             request.resource.data.get('approvedDateOfBirth', null) == resource.data.get('approvedDateOfBirth', null) &&
             request.resource.data.get('approvedGender', null) == resource.data.get('approvedGender', null) &&
             request.resource.data.get('approvedCitizenship', null) == resource.data.get('approvedCitizenship', null) &&
             request.resource.data.get('reviewedAt', null) == resource.data.get('reviewedAt', null) &&
             request.resource.data.get('rejectionReason', null) == resource.data.get('rejectionReason', null) &&
             request.resource.data.get('stats', null) == resource.data.get('stats', null));
      }

      // READ — the athlete themselves, or an admin. This was isSignedIn():
      // any account could read every athlete's email, date of birth,
      // citizenship and verification photo, minors' included.
      //
      // Every client read is the athlete's OWN document (fetchParticipant in
      // useOnlineAuth, the profile form, the solve page, RegistrationPanel).
      // Everything that shows OTHER athletes — the roster, live standings,
      // round results, group seeding, the review and athletes admin — reads
      // through server routes with the Admin SDK, which choose field by field
      // what leaves: name, initials and results (roster-view.ts, whose test
      // pins the exact keys). So the public half of an athlete needs no
      // client-readable copy.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isSignedIn() &&
                                request.auth.uid == uid &&
                                (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email) &&
                                (!('photoURL' in request.resource.data) || request.resource.data.photoURL == null || request.resource.data.photoURL is string) &&
                                (!('displayName' in request.resource.data) || request.resource.data.displayName is string) &&
                                (!('lastName' in request.resource.data) || request.resource.data.lastName is string) &&
                                (!('firstName' in request.resource.data) || request.resource.data.firstName is string) &&
                                (!('dateOfBirth' in request.resource.data) || request.resource.data.dateOfBirth is string) &&
                                (!('gender' in request.resource.data) || request.resource.data.gender in ['male', 'female', 'other']) &&
                                (!('citizenship' in request.resource.data) || request.resource.data.citizenship is string) &&
                                // Type-only, like its neighbours. wcaId is NOT in
                                // reviewedIdentityKeys() and has no approved* snapshot:
                                // a WCA id is public and independently checkable, so it
                                // needs no review machinery. Format is a UI concern.
                                (!('wcaId' in request.resource.data) || request.resource.data.wcaId is string) &&
                                (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null || request.resource.data.photoUrl is string) &&
                                (!('photoPublicId' in request.resource.data) || request.resource.data.photoPublicId == null || request.resource.data.photoPublicId is string) &&
                                profileStatusTransitionAllowed() &&
                                judgeFieldsUntouched();

      match /registrations/{competitionId} {
        // OWNER ONLY. This was `isSignedIn()` — any signed-in account could
        // read any athlete's registration, including the free-text note
        // whose placeholder asks for a contact phone number, and athlete
        // uids are public (the leaderboard documents are keyed by them).
        //
        // Nothing legitimate needs more: every client-side reader
        // (fetchRegistration, fetchMyRegistrations, and the transaction in
        // registerForCompetition) reads the signed-in athlete's own
        // documents, and the admin panel reads through API routes with the
        // Admin SDK, which bypasses these rules. isAdmin() is deliberately
        // NOT added — no client-side admin read exists to need it.
        allow read: if isSignedIn() && request.auth.uid == uid;
        // ── WRITES: the athlete's own fields only ───────────────────────
        // The athlete's client writes this document directly — there is no
        // API route in between — so these rules are the only server-side
        // check it gets. ADMINS write status and statusNote through the
        // admin API with the Admin SDK, which bypasses these rules; nothing
        // here grants an athlete either field.
        //
        // `note` is optional, a string of at most 300 characters. 300 is
        // REGISTRATION_NOTE_MAX in lib/online-competition/types.ts; rules
        // cannot import it, so change both together.
        function registrationShapeOk() {
          return request.resource.data.competitionId == competitionId &&
                 request.resource.data.events is list &&
                 request.resource.data.events.size() > 0 &&
                 (!('note' in request.resource.data) ||
                  (request.resource.data.note is string &&
                   request.resource.data.note.size() <= 300));
        }

        // CREATE — exactly the fields registerForCompetition's first save
        // writes (buildRegistrationWrite), and nothing else: so no
        // statusNote, and no admin field of any kind. The status must be
        // 'pending' — an athlete cannot register themselves as approved.
        // registeredAt must be the server's own clock: it orders a future
        // waitlist, and a client-supplied time would let an athlete date
        // their registration earlier than everyone else's.
        allow create: if isSignedIn() &&
                         request.auth.uid == uid &&
                         registrationShapeOk() &&
                         request.resource.data.keys().hasOnly(
                           ['competitionId', 'events', 'status', 'registeredAt', 'updatedAt', 'note']) &&
                         request.resource.data.status == 'pending' &&
                         request.resource.data.registeredAt == request.time;

        // UPDATE — the athlete may change ONLY these four fields:
        //   events, note, updatedAt  — an edit (buildRegistrationWrite)
        //   results                  — recordAo5Result's per-event map
        // Everything else must be byte-for-byte what is already stored.
        // That one condition is what makes status, statusNote, registeredAt
        // and competitionId unchangeable, AND stops an athlete adding a new
        // admin-only field, without listing any of them.
        //
        // A LEGACY 'registered' status is "unchanged" when it stays
        // 'registered': the diff compares stored against written, never
        // against the enum, so an edit that does not touch the status passes
        // whatever value is stored — which is exactly what the current
        // writer does. An OLD tab still running the pre-PR-0 writer (whole-
        // document setDoc) is refused: that writer re-stamps registeredAt,
        // which is now fixed. Reloading the page fixes it. That breakage is
        // the minimum: allowing it would mean letting an athlete move their
        // own place in the waitlist.
        allow update: if isSignedIn() &&
                         request.auth.uid == uid &&
                         registrationShapeOk() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['events', 'note', 'updatedAt', 'results']);
        allow delete: if false;
      }
    }

    // ── One attempt of one run ──────────────────────────────────────────
    // The ONLY thing an athlete may write here is a fresh, unjudged
    // attempt of their own. Before this, `create` checked nothing but the
    // uid — so a crafted client could file a submission already marked
    // status:'approved', with any time on it, and round-results,
    // seasonPoints and the athlete stats all trust that status. That was
    // the hole; everything below exists to close it.
    match /onlineSubmissions/{submissionId} {
      // Every field the client writer produces (createSubmission in
      // lib/online-competition/data.ts). hasOnly REFUSES anything else, so
      // a field nobody validates cannot be smuggled in alongside; hasAll
      // refuses a partial document that would read as a submission with
      // holes in it.
      //
      // 'marks', 'timerShotIds', 'cubeShotIds' and 'videoDurationMs' are
      // in hasOnly but deliberately NOT in hasAll: they are the optional
      // fields here. An attempt whose recorder never reported a start has
      // no marks, and videoDurationMs comes from the upload response, which
      // may omit it — neither is worth refusing a solve over.
      //
      // 'videoUrl' and 'cloudinaryPublicId' are NOT in hasOnly any more.
      // They were the legacy Cloudinary evidence; every new submission
      // carries a videoKey (R2), and a Cloudinary public id the athlete
      // chose was a name the nightly sweep would delete — a competition
      // poster, another athlete's photo. Documents already stored keep
      // theirs; these rules only govern new writes.
      function submissionKeysOk() {
        return request.resource.data.keys().hasOnly([
          'competitionId', 'uid', 'event', 'round', 'competitionRound',
          'videoKey', 'reportedTime', 'isDnf',
          'marks', 'timerShotIds', 'cubeShotIds', 'videoDurationMs',
          'penalty', 'status', 'createdAt', 'retentionExpiresAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'competitionId', 'uid', 'event', 'round', 'competitionRound',
          'videoKey', 'reportedTime', 'isDnf',
          'penalty', 'status', 'createdAt', 'retentionExpiresAt'
        ]);
      }

      // The stage marks (SolveMarks in types.ts): a map of ms offsets into
      // this attempt's video. Checked key by key rather than over
      // .values(), because the rules language has no way to assert a
      // predicate across a list — and checking each named key is the
      // stronger form anyway: hasOnly here means an unvalidated field
      // cannot be smuggled in INSIDE the map, which is exactly the hole
      // submissionKeysOk closes at the top level.
      //
      // EVERY KEY IS INDIVIDUALLY OPTIONAL. A run that files three of the
      // five marks is a normal outcome, not a malformed document, so the
      // shape is "absent, or a number" per key rather than hasAll.
      // Negative is refused: a mark is an offset from the first frame, and
      // there is no video before it.
      function markOk(key) {
        return !request.resource.data.marks.keys().hasAny([key]) ||
               (request.resource.data.marks[key] is number &&
                request.resource.data.marks[key] >= 0);
      }

      // The uploaded clip's length in ms (videoDurationMs in types.ts).
      // Absent, or a non-negative number — a duration cannot run
      // backwards, and the checks that read it compare it against marks
      // measured from the same zero.
      function submissionDurationOk() {
        return !request.resource.data.keys().hasAny(['videoDurationMs']) ||
               (request.resource.data.videoDurationMs is number &&
                request.resource.data.videoDurationMs >= 0);
      }

      // ── THE EVIDENCE: the writer's own R2 object, and nothing else ──
      // The legacy Cloudinary shape (videoUrl + cloudinaryPublicId) is no
      // longer accepted: submissionKeysOk refuses both keys. Everything
      // that could name an asset now names one under this athlete's own
      // prefix, for this exact attempt — see videoKeyOk.

      // THE KEY MUST BE THE WRITER'S OWN, AND FOR THIS ATTEMPT. The presign
      // route derives keys server-side, but it is the client that writes
      // one here — so without this an athlete could file a document that
      // points at another athlete's video, or at their own attempt 1 from
      // attempt 5. string() on the two ints is exact because they are
      // checked `is int` before this runs. [.] rather than an escaped dot,
      // so the pattern survives the rules string literal unambiguously.
      function videoKeyOk() {
        return request.resource.data.videoKey is string &&
               request.resource.data.videoKey.size() <= 512 &&
               request.resource.data.videoKey.matches(
                 'videos/' + request.resource.data.uid + '/' +
                 request.resource.data.competitionId + '/' +
                 request.resource.data.event + '/r' +
                 string(request.resource.data.competitionRound) + '/a' +
                 string(request.resource.data.round) + '/[A-Za-z0-9-]+[.]webm'
               );
      }

      function submissionEvidenceOk() {
        return request.resource.data.keys().hasAny(['videoKey']) && videoKeyOk();
      }

      function submissionMarksOk() {
        return !request.resource.data.keys().hasAny(['marks']) ||
               (request.resource.data.marks is map &&
                request.resource.data.marks.keys().hasOnly([
                  'scrambleShown', 'coverStart', 'solveStart', 'solveEnd', 'cubeShown',
                  'recordingEnd'
                ]) &&
                markOk('scrambleShown') &&
                // The reveal handing over to the cover stage. Optional in
                // exactly the way every other mark here is — markOk()
                // passes an absent key — but optional for a second reason
                // too: submissions predating this mark carry the other
                // five without it, and must keep being accepted.
                markOk('coverStart') &&
                markOk('solveStart') &&
                markOk('solveEnd') &&
                markOk('cubeShown') &&
                markOk('recordingEnd'));
      }

      // The still ids (timerShotIds / cubeShotIds in types.ts): LEGACY.
      // Stills are no longer captured, so a new submission may carry these
      // only ABSENT or EMPTY — createSubmission still writes two empty
      // lists. A non-empty list was a set of Cloudinary IMAGE public ids
      // the athlete chose, which cleanup deleted: the same endpoint that
      // holds competition posters and profile photos.
      function shotIdsOk(key) {
        return !request.resource.data.keys().hasAny([key]) ||
               (request.resource.data[key] is list &&
                request.resource.data[key].size() == 0);
      }

      function submissionTypesOk() {
        return request.resource.data.competitionId is string &&
               request.resource.data.competitionId.size() > 0 &&
               request.resource.data.event is string &&
               request.resource.data.event.size() > 0 &&
               // The attempt within the run, and the competition round the
               // run belongs to. Ints, so the id built from them below is
               // "1" and never "1.0".
               request.resource.data.round is int &&
               request.resource.data.round >= 1 &&
               // 5 is the most attempts any current resultFormat has
               // (attemptsForFormat: ao5 5, mo3/bo3 3, bo2 2, bo1 1). A
               // longer format would have to raise this.
               request.resource.data.round <= 5 &&
               request.resource.data.competitionRound is int &&
               request.resource.data.competitionRound >= 1 &&
               // The evidence. A submission without a video is one a judge
               // can only reject — see submissionEvidenceOk for its shapes.
               // After the int checks above, which videoKeyOk relies on.
               submissionEvidenceOk() &&
               // Centiseconds; 0 is what a DNF stores.
               request.resource.data.reportedTime is number &&
               request.resource.data.reportedTime >= 0 &&
               request.resource.data.isDnf is bool &&
               // In the FUTURE, and not absurdly far. The client computes it
               // as now + 14 days. A date already past was how a forged
               // submission got swept — and its named assets deleted — the
               // next night. The sweep no longer trusts this alone (it
               // deletes on createdAt, pinned below to request.time, plus the
               // retention period), so the bounds are wide: a device clock
               // days out must not make a real solve unfileable.
               request.resource.data.retentionExpiresAt is timestamp &&
               request.resource.data.retentionExpiresAt > request.time &&
               request.resource.data.retentionExpiresAt < request.time + duration.value(60, 'd');
      }

      // THE DOCUMENT ID MUST DESCRIBE ITS OWN CONTENTS. The id is built by
      // submissionDocId (lib/online-competition/submission-id.ts) and is
      // what makes filing an attempt twice an overwrite rather than a
      // duplicate — but the client picks it, so without this a run could
      // file attempt 3's solve under attempt 5's id and the deterministic
      // id would be describing a lie.
      //
      // string() on the two ints is exact because they are checked `is int`
      // above.
      function submissionIdMatchesContents() {
        return submissionId ==
          request.resource.data.uid + '__' +
          request.resource.data.competitionId + '__' +
          request.resource.data.event + '__r' +
          string(request.resource.data.competitionRound) + '__a' +
          string(request.resource.data.round);
      }

      // ── THE ROUND AND THE ATTEMPT MUST BE ONES THE SERVER ADMITTED ──
      // competitionRound used to be whatever the client wrote (an int >= 1),
      // so a round-1 non-qualifier — or someone never registered — could
      // file straight into any round.
      //
      // The decision is NOT re-made here. Which round is live, whether the
      // athlete is registered, approved and qualified, which scramble they
      // were given: that is the scramble route's gate (scramble-gate.ts),
      // and the gate records its answer as a run ticket. This rule only
      // requires that ticket to exist for this (uid, event, round), and
      // this attempt to be one whose scramble was served (<= servedThrough).
      //
      // WHAT THIS GUARANTEES: the gate admitted this athlete to this round
      // of this event, and served them at least this many attempts.
      // WHAT IT DOES NOT: that they are still registered or the round still
      // open at the moment of filing (deliberately — an upload may land
      // after an admin closes the round, and must still file), or anything
      // about the solve itself.
      //
      // One document read per create. The ticket id format is repeated from
      // runTicketId (scramble-gate.ts); tests pin the two together.
      function runTicketOk() {
        let ticket = /databases/$(database)/documents/onlineCompetitions/$(request.resource.data.competitionId)/runTickets/$(request.resource.data.uid + '__' + request.resource.data.event + '__r' + string(request.resource.data.competitionRound));
        return exists(ticket) &&
               get(ticket).data.servedThrough is number &&
               request.resource.data.round <= get(ticket).data.servedThrough;
      }

      allow read: if isSignedIn() &&
                     (resource.data.uid == request.auth.uid || isAdmin());

      // A PENDING attempt, owned by the writer, at its own id. The judge's
      // verdict is not the athlete's to write: status and penalty are
      // pinned here and may only move later, through the review route,
      // which uses the Admin SDK and bypasses these rules entirely.
      allow create: if isSignedIn() &&
                       request.resource.data.uid == request.auth.uid &&
                       submissionKeysOk() &&
                       submissionTypesOk() &&
                       submissionMarksOk() &&
                       submissionDurationOk() &&
                       shotIdsOk('timerShotIds') &&
                       shotIdsOk('cubeShotIds') &&
                       submissionIdMatchesContents() &&
                       runTicketOk() &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.penalty == null &&
                       request.resource.data.createdAt == request.time;

      // ATHLETES HAVE NO UPDATE. A filed attempt is immutable to the
      // person who filed it: the old rule let an athlete rewrite their own
      // pending attempt's reportedTime and videoUrl, which is the same
      // thing as re-solving a bad attempt. Nothing in the client updates a
      // submission — createSubmission is the only client writer, and it
      // only ever creates.
      //
      // The judge's route does not come through here (Admin SDK), so this
      // leaves only the club-site admin, who could already write anything.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Per-athlete notification feed for the online-competition platform.
    // Written ONLY server-side, by the Admin SDK (the judge-decision route
    // app/api/online-competition/review/route.ts), which bypasses these
    // rules entirely — so `create` is denied to every client, matching how
    // onlineSubmissions.status/penalty are handled. The owner may read
    // their own notifications and flip nothing but the `read` flag.
    match /onlineNotifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn() &&
                       resource.data.uid == request.auth.uid &&
                       request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // Rate-limit counters for the judges' login
    // (lib/online-competition/admin-login-limit.ts). Admin SDK only; no
    // client — admin or not — may read or write them.
    match /onlineAdminLoginAttempts/{key} {
      allow read, write: if false;
    }

    // The record of a competition deletion — what was removed, what could
    // not be, and which admin session started it
    // (lib/online-competition/competition-delete.ts). Admin SDK only; it
    // outlives the competition, and no client may read or rewrite it.
    match /onlineCompetitionDeletions/{competitionId} {
      allow read, write: if false;
    }

    // Season points were REMOVED. The stored documents are kept (a later
    // rebuild may want them), but nothing reads or writes this collection
    // any more — so no client may. It was publicly readable.
    match /onlineSeasonPoints/{season} {
      match /athletes/{uid} {
        allow read, write: if false;
      }
    }
  }
}