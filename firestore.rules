rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // The club admin: users/{uid}.role == 'admin'.
    //
    // FAILS CLOSED. No users document, no role field, or any value other
    // than the exact string 'admin' is not an admin. exists() first, so a
    // missing document is a plain false rather than an evaluation error.
    //
    // Only safe because clients cannot write their own role — see
    // match /users/{uid}. Every rule below that calls this depends on that.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // A competition judge: signed in with the custom token app/api/judge/login
    // issues after checking the competition's PIN on the server. The claims
    //   { role: 'judge', competitionId, pinVersion, validUntil }
    // are set by the server only — a client cannot mint or alter them.
    //
    // FAILS CLOSED, and every condition is re-checked on every request, so
    // access ends by itself, with no sign-out needed, the moment any of
    // these stops holding:
    //   - the token names THIS competition (never any other);
    //   - it is not older than its 24 h (validUntil, epoch ms);
    //   - the competition is not finished;
    //   - the PIN it was issued for is still the current, enabled one
    //     (private/judgeAccess.version — regenerating or disabling the PIN
    //     changes it, which revokes every session issued before).
    // A judge is NOT an admin: isAdmin() reads users/{uid}.role, and a judge
    // session has no users document (and may not create one — see /users).
    function isJudgeOf(compId) {
      let comp = /databases/$(database)/documents/competitions/$(compId);
      let access = /databases/$(database)/documents/competitions/$(compId)/private/judgeAccess;
      return isSignedIn() &&
        request.auth.token.get('role', '') == 'judge' &&
        request.auth.token.get('competitionId', '') == compId &&
        request.time.toMillis() < request.auth.token.get('validUntil', 0) &&
        exists(comp) && get(comp).data.get('status', '') != 'finished' &&
        exists(access) && get(access).data.get('enabled', false) == true &&
        get(access).data.get('version', '') == request.auth.token.get('pinVersion', '-');
    }

    // ─── Existing collections ─────────────────────────────────────────────────

    // ── athletes/{athleteId} — the club's PUBLIC athlete profile ──────────
    // Readable by anyone, signed out included: the club site's athletes,
    // rankings, records and competition pages read it directly. So it may
    // hold only what a WCA-style public profile shows — name, photo
    // (imageUrl), WCA id — plus the ownerId link the profile page's claim
    // picker filters on.
    //
    // Date of birth and phone live in athletes/{athleteId}/private/identity
    // (lib/firebase/services/athletes.ts). Rules cannot hide one field of a
    // readable document, so a split is the only way to keep them private.
    // The public write rule refuses both keys, so no client — an old tab
    // included — can put one back. scripts/move-athlete-private-fields.mjs
    // moves the existing values across; it must run BEFORE these rules are
    // deployed, or an admin edit of an unmoved athlete is refused.
    match /athletes/{athleteId} {
      function athletePrivateKeys() {
        return ['birthDate', 'phone'];
      }

      allow read: if true;
      allow create, update: if isAdmin() &&
                               !request.resource.data.keys().hasAny(athletePrivateKeys());
      allow delete: if isAdmin();

      // Admins, and the signed-in account this athlete is linked to (ownerId,
      // set by the admin link or an approved claim). Nobody else — not even
      // an account that owns a DIFFERENT athlete. A missing parent makes
      // get() an error, which denies.
      match /private/{docId} {
        allow read: if isAdmin() ||
                       (isSignedIn() &&
                        get(/databases/$(database)/documents/athletes/$(athleteId)).data.get('ownerId', null) == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    // The competition document itself is public (every public page reads it).
    // Anything that must not be seen before a round is held lives in
    // competitions/{id}/private/* — the imported WCA scrambles
    // (private/scrambles), the staged imported results
    // (private/importedResults_{eventId}) and the judge PIN hash
    // (private/judgeAccess). Rules don't cascade, so the parent's
    // `allow read: if true` grants nothing here.
    match /competitions/{doc} {
      allow read: if true;
      allow write: if isAdmin();

      // Admin: everything. A judge of this competition: a single-document
      // read of private/scrambles ONLY (the panel shows the scramble being
      // judged) — no listing, no write, and none of the other private
      // documents: not judgeAccess (the PIN hash), not importedResults_*
      // (every imported result not yet revealed; the reveal runs on the
      // server, app/api/staged/sync, precisely so judges need no access).
      match /private/{docId} {
        allow read, write: if isAdmin();
        allow get: if docId == 'scrambles' && isJudgeOf(doc);
      }
    }

    // ── results/{docId} ───────────────────────────────────────────────────
    // Public to read. WRITES ARE ADMIN-ONLY, plus the narrow judge case
    // below. This used to be `allow write: if isSignedIn()`: any Google
    // account could create, overwrite or delete any result.
    //
    // A judge of the result's competition may:
    //   create — an entered ('entry'), published club result, with a judge
    //            named on it who is not the athlete, under the one
    //            deterministic id for that competition+event+round+athlete.
    //            The fixed id is what stops a second result for the same
    //            athlete and round.
    //   update — the same, but only over a next-round PLACEHOLDER (the row
    //            advancement creates for a qualified athlete). A result that
    //            already holds solves cannot be changed by a judge.
    // and may never delete, write an imported result (reveals are written by
    // the server), or touch another competition's results.
    //
    // Either way only the athlete's CURRENT round (lib/round-progress.ts):
    // round 1 — created, for an event the athlete is registered for; round
    // N+1 — over its placeholder, i.e. they advanced, and only once round N
    // is marked complete. Never a round already marked complete.
    // Registration is read from competition.registrations (written with the
    // roster by the competition form); a competition not saved since that
    // field was added has none and is not checked for it.
    match /results/{docId} {
      function judgeEntry() {
        let d = request.resource.data;
        return d.get('competitionId', '') is string && isJudgeOf(d.get('competitionId', '')) &&
          d.get('source', '') == 'entry' &&
          d.get('status', '') == 'published' &&
          d.get('isPlaceholder', false) == false &&
          d.get('athleteId', '') is string && d.get('athleteId', '') != '' &&
          d.get('eventId', '') is string && d.get('round', 0) is int &&
          d.get('judgeAthleteId', '') is string && d.get('judgeAthleteId', '') != '' &&
          d.judgeAthleteId != d.athleteId &&
          docId == d.competitionId + '_' + d.eventId + '_r' + string(d.round) + '_' + d.athleteId;
      }

      // Called after judgeEntry(), so competitionId/eventId/round are typed.
      function judgeRoundOpen() {
        let d = request.resource.data;
        let comp = get(/databases/$(database)/documents/competitions/$(d.competitionId)).data;
        let status = comp.get('roundStatus', {});
        let registered = !('registrations' in comp) ||
          comp.registrations.get(d.athleteId, {}).get(d.eventId, false) == true;
        return status.get(d.eventId + '_r' + string(d.round), '') != 'complete' &&
          ((d.round == 1 && registered) ||
           (d.round > 1 && status.get(d.eventId + '_r' + string(d.round - 1), '') == 'complete'));
      }

      allow read: if true;
      allow write: if isAdmin();
      allow create: if judgeEntry() && request.resource.data.round == 1 && judgeRoundOpen();
      allow update: if judgeEntry() && resource.data.get('isPlaceholder', false) == true && judgeRoundOpen();
    }

    // ── users/{uid} — the club account ───────────────────────────────────
    // `role` is what isAdmin() reads, so NO CLIENT MAY GRANT ITSELF A ROLE.
    // This used to be `allow write: if request.auth.uid == uid`: any
    // signed-in user could set role: 'admin' on their own document and then
    // approve their own submissions, delete rivals', and read every draft.
    //
    // What each client write may do now:
    //   create — only your own document, and only as 'member' (or with no
    //            role). That is exactly what auth-context's first-sign-in
    //            upsert writes.
    //   update — your own document, any field EXCEPT role (the sign-in
    //            refresh, the profile edit, every points.ts transaction);
    //            or, as an admin, any user's document including role (the
    //            club admin's UsersTab: role change, points, athlete link).
    //   delete — your own document, or any as an admin. Deleting your own
    //            and re-creating it can only land you back on 'member'.
    //
    // READ — your own document, or any as an admin. This was isSignedIn():
    // every account's email was readable by every other account. Nothing
    // legitimate reads someone else's: auth-context, the timer profile and
    // points.ts read their own; UsersTab, the admin dashboard and a claim
    // approval (awardAthleteLinked) run as an admin; match history takes each
    // player's avatar from the multiplayer room instead.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // A judge session (PIN login) is not a club account and gets no
      // users document — nothing for a role to ever be attached to.
      allow create: if isSignedIn() &&
                       request.auth.uid == uid &&
                       request.auth.token.get('role', '') != 'judge' &&
                       (!('role' in request.resource.data) || request.resource.data.role == 'member');
      allow update: if isSignedIn() &&
                       ((request.auth.uid == uid &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
                        isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /assignments/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wcaRecords/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /athleteRequests/{doc} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /matchHistory/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /pointTransactions/{doc} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    // ─── Coach challenge: coaches and rooms (docs/challenge-plan.md, phase 2) ─
    //
    // coaches/{uid} — the coach list, granted by the club admin from the
    // admin users tab. Admins are coaches automatically and need no
    // document (lib/server/firebase-admin.ts isCoachUid). Nobody can grant
    // themselves: only isAdmin() writes, and isAdmin() itself fails closed.
    match /coaches/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // roomCodes/{code} → roomId. Server-only: a student joins through
    // app/api/rooms/join, which looks the code up itself, so codes can't be
    // listed or probed from a client.
    match /roomCodes/{code} {
      allow read, write: if false;
    }

    // rooms/{roomId} and rooms/{roomId}/members/{uid}: every WRITE goes
    // through app/api/rooms/* (create, rename, regenerate-code, join,
    // member) with the Admin SDK, which bypasses these rules. No client may
    // create a room, approve itself, change a status or pick a code.
    //
    // Reads:
    //   room     — its coach; a pending or active member. A removed member
    //              no longer reads the room (they keep their own membership,
    //              below, which carries the room's name).
    //   members  — the student reads their OWN membership always, removed
    //              included (plan N4: a removed student still sees their
    //              history). The room's coach reads pending and active
    //              members only — never a removed one (plan decision 24:
    //              name/photo only for coaches of rooms they belong to);
    //              re-adding = the student asks again and the coach approves.
    match /rooms/{roomId} {
      function myMembership() {
        return /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid);
      }
      function isRoomCoach() {
        return get(/databases/$(database)/documents/rooms/$(roomId)).data.coachUid == request.auth.uid;
      }

      allow get: if isSignedIn() &&
                    (resource.data.coachUid == request.auth.uid ||
                     (exists(myMembership()) && get(myMembership()).data.status in ['pending', 'active']));
      // "My rooms" for a coach: where('coachUid', '==', me).
      allow list: if isSignedIn() && resource.data.coachUid == request.auth.uid;
      allow write: if false;

      match /members/{uid} {
        allow get: if isSignedIn() &&
                      (request.auth.uid == uid ||
                       (isRoomCoach() && resource.data.status in ['pending', 'active']));
        // The coach's list must filter status in ['pending', 'active'].
        allow list: if isSignedIn() && isRoomCoach() && resource.data.status in ['pending', 'active'];
        allow write: if false;
      }
    }

    // A student's own memberships across all rooms:
    // collectionGroup('members').where('uid', '==', me).
    match /{path=**}/members/{uid} {
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ─── Coach challenge: challenges and assignments (phase 3) ───────────────
    //
    // Every WRITE goes through app/api/challenge/* (create, update, delete,
    // duplicate, assign, unassign) with the Admin SDK. No client — not the
    // coach, not the admin — may create, edit, lock/unlock, assign or touch
    // progress. The edit lock after the first start (decision 9) is
    // enforced in lib/server/challenges.ts, which refuses update/delete
    // while `locked` is true.
    //
    // challenges/{id} — read by its coach only. Students never read it: the
    // template is copied into their assignment.
    match /challenges/{challengeId} {
      allow read: if isSignedIn() && resource.data.coachUid == request.auth.uid;
      allow write: if false;
    }

    // challengeAssignments/{challengeId}_{studentUid}
    //   the student — always, removed or not (plan N4);
    //   the coach   — only while visibleToCoach == true, i.e. the student's
    //                 membership is not 'removed' (decision 24). The server
    //                 flips it on remove / re-approve (lib/server/rooms.ts);
    //                 a rule can't get() the membership per document in a
    //                 list query, hence the copied flag. The coach's queries
    //                 must filter visibleToCoach == true.
    match /challengeAssignments/{assignmentId} {
      allow read: if isSignedIn() &&
                     (resource.data.studentUid == request.auth.uid ||
                      (resource.data.coachUid == request.auth.uid && resource.data.visibleToCoach == true));
      allow write: if false;
    }

    // ─── Coach challenge: sessions and the live pointer (phase 4) ────────────
    //
    // Both are written ONLY by app/api/challenge/{start,solve,comment,end}
    // (lib/server/challenge-sessions.ts). No client may start a session —
    // not even its own student — log a solve, change progress, or point
    // the timer at a session.
    //
    // challengeSessions/{id} — the student always (removed or not, N4);
    // the coach while visibleToCoach == true (same flag and reason as for
    // assignments; lib/server/rooms.ts keeps both in step).
    match /challengeSessions/{sessionId} {
      allow read: if isSignedIn() &&
                     (resource.data.studentUid == request.auth.uid ||
                      (resource.data.coachUid == request.auth.uid && resource.data.visibleToCoach == true));
      allow write: if false;
    }

    // challengeLive/{studentUid} — the student's timer listens to its own
    // pointer; nobody else reads it.
    match /challengeLive/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── Virtual Competitions ─────────────────────────────────────────────────

    match /virtualCompetitions/{compId} {
      allow read: if isAdmin() ||
                     !('status' in resource.data) ||
                     resource.data.status != 'draft';
      allow write: if isAdmin();

      match /rounds/{roundId} {
        allow read: if isAdmin() ||
                       !('status' in get(/databases/$(database)/documents/virtualCompetitions/$(compId)).data) ||
                       get(/databases/$(database)/documents/virtualCompetitions/$(compId)).data.status != 'draft';
        allow write: if isAdmin();
      }

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      }

      match /participantResults/{resultId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == resultId.split('_')[0];
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /attempts/{attemptId} {
        allow read: if isSignedIn() &&
                       (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow delete: if isAdmin();

        match /results/{resultId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if isAdmin();
        }
      }
    }

    match /{path=**}/attempts/{attemptId} {
      allow read: if isSignedIn() &&
                     (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /{path=**}/results/{resultId} {
      allow read: if isSignedIn();
    }
  }
}