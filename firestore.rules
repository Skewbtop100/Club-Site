rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // The club admin: users/{uid}.role == 'admin'.
    //
    // FAILS CLOSED. No users document, no role field, or any value other
    // than the exact string 'admin' is not an admin. exists() first, so a
    // missing document is a plain false rather than an evaluation error.
    //
    // Only safe because clients cannot write their own role — see
    // match /users/{uid}. Every rule below that calls this depends on that.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // ─── Existing collections ─────────────────────────────────────────────────

    // ── athletes/{athleteId} — the club's PUBLIC athlete profile ──────────
    // Readable by anyone, signed out included: the club site's athletes,
    // rankings, records and competition pages read it directly. So it may
    // hold only what a WCA-style public profile shows — name, photo
    // (imageUrl), WCA id — plus the ownerId link the profile page's claim
    // picker filters on.
    //
    // Date of birth and phone live in athletes/{athleteId}/private/identity
    // (lib/firebase/services/athletes.ts). Rules cannot hide one field of a
    // readable document, so a split is the only way to keep them private.
    // The public write rule refuses both keys, so no client — an old tab
    // included — can put one back. scripts/move-athlete-private-fields.mjs
    // moves the existing values across; it must run BEFORE these rules are
    // deployed, or an admin edit of an unmoved athlete is refused.
    match /athletes/{athleteId} {
      function athletePrivateKeys() {
        return ['birthDate', 'phone'];
      }

      allow read: if true;
      allow create, update: if isAdmin() &&
                               !request.resource.data.keys().hasAny(athletePrivateKeys());
      allow delete: if isAdmin();

      // Admins, and the signed-in account this athlete is linked to (ownerId,
      // set by the admin link or an approved claim). Nobody else — not even
      // an account that owns a DIFFERENT athlete. A missing parent makes
      // get() an error, which denies.
      match /private/{docId} {
        allow read: if isAdmin() ||
                       (isSignedIn() &&
                        get(/databases/$(database)/documents/athletes/$(athleteId)).data.get('ownerId', null) == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    match /competitions/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /results/{doc} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── users/{uid} — the club account ───────────────────────────────────
    // `role` is what isAdmin() reads, so NO CLIENT MAY GRANT ITSELF A ROLE.
    // This used to be `allow write: if request.auth.uid == uid`: any
    // signed-in user could set role: 'admin' on their own document and then
    // approve their own submissions, delete rivals', and read every draft.
    //
    // What each client write may do now:
    //   create — only your own document, and only as 'member' (or with no
    //            role). That is exactly what auth-context's first-sign-in
    //            upsert writes.
    //   update — your own document, any field EXCEPT role (the sign-in
    //            refresh, the profile edit, every points.ts transaction);
    //            or, as an admin, any user's document including role (the
    //            club admin's UsersTab: role change, points, athlete link).
    //   delete — your own document, or any as an admin. Deleting your own
    //            and re-creating it can only land you back on 'member'.
    //
    // READ — your own document, or any as an admin. This was isSignedIn():
    // every account's email was readable by every other account. Nothing
    // legitimate reads someone else's: auth-context, the timer profile and
    // points.ts read their own; UsersTab, the admin dashboard and a claim
    // approval (awardAthleteLinked) run as an admin; match history takes each
    // player's avatar from the multiplayer room instead.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.auth.uid == uid &&
                       (!('role' in request.resource.data) || request.resource.data.role == 'member');
      allow update: if isSignedIn() &&
                       ((request.auth.uid == uid &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
                        isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /assignments/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wcaRecords/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /athleteRequests/{doc} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /matchHistory/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /pointTransactions/{doc} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    // ─── Virtual Competitions ─────────────────────────────────────────────────

    match /virtualCompetitions/{compId} {
      allow read: if isAdmin() ||
                     !('status' in resource.data) ||
                     resource.data.status != 'draft';
      allow write: if isAdmin();

      match /rounds/{roundId} {
        allow read: if isAdmin() ||
                       !('status' in get(/databases/$(database)/documents/virtualCompetitions/$(compId)).data) ||
                       get(/databases/$(database)/documents/virtualCompetitions/$(compId)).data.status != 'draft';
        allow write: if isAdmin();
      }

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      }

      match /participantResults/{resultId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == resultId.split('_')[0];
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /attempts/{attemptId} {
        allow read: if isSignedIn() &&
                       (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow delete: if isAdmin();

        match /results/{resultId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if isAdmin();
        }
      }
    }

    match /{path=**}/attempts/{attemptId} {
      allow read: if isSignedIn() &&
                     (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /{path=**}/results/{resultId} {
      allow read: if isSignedIn();
    }
  }
}