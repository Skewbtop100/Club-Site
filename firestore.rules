rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Checks users/{uid}.role == 'admin' in Firestore — matches the app-level
    // auth check (useAuth().user.role). No custom claims needed.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Existing collections ─────────────────────────────────────────────────
    // TODO: tighten these rules for each collection as needed.

    match /athletes/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /competitions/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /results/{doc} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /assignments/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wcaRecords/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /athleteRequests/{doc} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /matchHistory/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /pointTransactions/{doc} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    // ─── Virtual Competitions ─────────────────────────────────────────────────

    match /virtualCompetitions/{compId} {
      // Defensive: allow read for anything that is not explicitly 'draft'.
      // Old docs may lack the status field; denying them would break the list page.
      allow read: if isAdmin() ||
                     !('status' in resource.data) ||
                     resource.data.status != 'draft';
      allow write: if isAdmin();

      match /rounds/{roundId} {
        allow read: if isAdmin() ||
                       !('status' in get(/databases/$(database)/documents/virtualCompetitions/$(compId)).data) ||
                       get(/databases/$(database)/documents/virtualCompetitions/$(compId)).data.status != 'draft';
        allow write: if isAdmin();
      }

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      }

      match /participantResults/{resultId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == resultId.split('_')[0];
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /attempts/{attemptId} {
        allow read: if isSignedIn() &&
                       (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow delete: if isAdmin();

        match /results/{resultId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if isAdmin();
        }
      }
    }

    // Collection group rules
    match /{path=**}/attempts/{attemptId} {
      allow read: if isSignedIn() &&
                     (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /{path=**}/results/{resultId} {
      allow read: if isSignedIn();
    }

    // ─── Online Competition (public, isolated) ─────────────────────────────
    // Fully separate feature for the public online competition — never
    // reads/writes athletes, competitions, or results above. Reuses the
    // same isAdmin() helper (users/{uid}.role == 'admin') so competition
    // judges are club admins, but the collections themselves are new and
    // untouched by any existing rule block.

    match /onlineCompetitions/{competitionId} {
      allow read: if true;
      allow write: if isAdmin();

      match /scrambles/{scrambleId} {
        allow read: if isSignedIn();
        // Created client-side (getOrCreateScramble) the first time a
        // participant needs a given event/round's scramble; never updated
        // afterwards so every participant sees the same scramble.
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /onlineParticipants/{uid} {
     allow read: if isSignedIn();
  allow create, update: if isSignedIn() &&
                            request.auth.uid == uid &&
                            (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email) &&
                            (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string) &&
                            (!('displayName' in request.resource.data) || request.resource.data.displayName is string);

  match /registrations/{competitionId} {
    allow read: if isSignedIn();
    allow create, update: if isSignedIn() &&
                              request.auth.uid == uid &&
                              request.resource.data.competitionId == competitionId &&
                              request.resource.data.events is list &&
                              request.resource.data.events.size() > 0;
    allow delete: if false;
  }
    }

    match /onlineSubmissions/{submissionId} {
      allow read: if isSignedIn() &&
                     (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Owner may edit their own doc, but never the fields a judge owns
      // (status/penalty) — only isAdmin() can touch those.
      allow update: if isAdmin() ||
                       (isSignedIn() &&
                        resource.data.uid == request.auth.uid &&
                        request.resource.data.uid == resource.data.uid &&
                        request.resource.data.status == resource.data.status &&
                        request.resource.data.penalty == resource.data.penalty);
      allow delete: if isAdmin();
    }

match /onlineSeasonPoints/{season} {
  match /athletes/{uid} {
    allow read: if true;
    allow write: if false;
  }
}

  }
}
