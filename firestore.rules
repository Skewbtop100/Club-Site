rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Existing collections ─────────────────────────────────────────────────

    match /athletes/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /competitions/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /results/{doc} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /assignments/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wcaRecords/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /athleteRequests/{doc} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /matchHistory/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /pointTransactions/{doc} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    // ─── Virtual Competitions ─────────────────────────────────────────────────

    match /virtualCompetitions/{compId} {
      allow read: if isAdmin() ||
                     !('status' in resource.data) ||
                     resource.data.status != 'draft';
      allow write: if isAdmin();

      match /rounds/{roundId} {
        allow read: if isAdmin() ||
                       !('status' in get(/databases/$(database)/documents/virtualCompetitions/$(compId)).data) ||
                       get(/databases/$(database)/documents/virtualCompetitions/$(compId)).data.status != 'draft';
        allow write: if isAdmin();
      }

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      }

      match /participantResults/{resultId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == resultId.split('_')[0];
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /attempts/{attemptId} {
        allow read: if isSignedIn() &&
                       (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow delete: if isAdmin();

        match /results/{resultId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if isAdmin();
        }
      }
    }

    match /{path=**}/attempts/{attemptId} {
      allow read: if isSignedIn() &&
                     (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /{path=**}/results/{resultId} {
      allow read: if isSignedIn();
    }

    // ─── Online Competition (public, isolated) ─────────────────────────────

    match /onlineCompetitions/{competitionId} {
      // Drafts are private: a competition is created as a draft and must
      // not be reachable — by list OR by direct id — until an admin moves
      // it on.
      //
      // Modelled on the virtualCompetitions block above but deliberately
      // NOT identical to it. That one reads
      //     isAdmin() || !('status' in resource.data) || status != 'draft'
      // and the middle clause silently defeats the whole guard on list
      // queries: because the rule permits documents that lack the field,
      // Firestore can no longer statically prove an UNFILTERED query is
      // safe — and rather than refusing it, it allows the query and
      // returns the drafts. Verified against the emulator: with that
      // clause present, an anonymous getDocs() of the whole collection
      // succeeds and includes every draft. (virtualCompetitions still has
      // this hole — see the note in tests/firestore-rules/README.md.)
      //
      // Dropping the clause is what makes the guard real, at one cost: a
      // doc with NO `status` field at all is now unreadable to clients
      // (it fails `resource.data.status != 'draft'` outright) rather than
      // being treated as public. Every doc toFirestoreDoc writes has a
      // status and the type declares it required, so this is theoretical;
      // and it changes nothing for the public LIST either way, since the
      // inequality filter that list must use already skips field-less
      // docs. Test 8 in competitions.test.mjs pins this trade-off.
      //
      // The `isAdmin()` disjunct is the club's Firebase Auth admin. It is
      // effectively dead for this feature — the online-competition admin
      // is a shared password, not an auth identity, so there is no
      // request.auth for it to match — and is kept only so a club admin
      // is never locked out of a collection they can already write.
      //
      // Hiding drafts at the rules layer WORKS regardless, because the
      // online-competition admin UI never reads this collection through
      // the client SDK: it goes via the admin-cookie-gated
      // /api/online-competition/admin-competitions routes, which use the
      // Admin SDK and bypass rules entirely. The admin still sees every
      // draft while no client can.
      //
      // Consequence for callers: a list query here is allowed only if it
      // PROVES it excludes drafts, e.g. where('status', '!=', 'draft')
      // (what fetchAllCompetitions issues). An unfiltered getDocs() fails.
      allow read: if isAdmin() || resource.data.status != 'draft';
      allow write: if isAdmin();

      match /scrambles/{scrambleId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      // Official imported scrambles + snake-seeded group assignments
      // (app/online-competition/admin/scrambles). Written and read
      // exclusively by the Admin SDK from admin-cookie-gated API routes
      // — the online-competition admin is a shared password, not a
      // Firebase Auth identity, so there is no request.auth for a rule
      // here to check. Denied to every client: reading scrambleData
      // directly would hand an athlete every group's scrambles before
      // they solve. Explicit rather than relying on the default deny.
      match /scrambleData/{roundId} {
        allow read, write: if false;
      }
      match /groupAssignments/{roundId} {
        allow read, write: if false;
      }

      // Round state + qualifier lists (app/online-competition/admin/rounds).
      // Same reasoning as the two above: written only by the Admin SDK from
      // admin-cookie-gated routes, and read server-side when gating a solve.
      // Denied to clients so an athlete can't read who qualified — or, worse,
      // mark themselves qualified.
      match /roundState/{roundId} {
        allow read, write: if false;
      }
      match /qualifiers/{roundId} {
        allow read, write: if false;
      }
    }

    match /onlineParticipants/{uid} {
      function priorProfileStatus() {
        return (resource == null || !('profileStatus' in resource.data))
          ? 'incomplete'
          : resource.data.profileStatus;
      }

      // The identity an admin actually reviews. Changing any of these
      // invalidates a prior approval, so a write that touches one must
      // also carry a legal profileStatus transition (see below).
      // NOTE `photoUrl` (the submitted verification photo) is NOT
      // `photoURL` (the Google avatar the sign-in upsert syncs) — the
      // casing is the whole difference and only the former is reviewed.
      function reviewedIdentityKeys() {
        return ['lastName', 'firstName', 'dateOfBirth', 'gender', 'citizenship', 'photoUrl'];
      }

      // Does this write ADD, CHANGE or REMOVE a reviewed identity field?
      // affectedKeys() is the diff, so a merge write that merely carries
      // an unchanged value forward does not count as touching it.
      function touchesReviewedIdentity() {
        return resource == null
          ? request.resource.data.keys().hasAny(reviewedIdentityKeys())
          : request.resource.data.diff(resource.data).affectedKeys().hasAny(reviewedIdentityKeys());
      }

      // ── Which profileStatus values a client may produce ─────────────
      //
      // Every client write here is a merge/update, so request.resource.data
      // is the FULL resulting document: an existing profileStatus is
      // carried forward whether the client mentioned it or not. Rules
      // therefore CANNOT distinguish "explicitly wrote 'approved'" from
      // "left the existing 'approved' alone". What they can do is forbid
      // the value from CHANGING to approved, which is the only case that
      // grants anything — see the note above `allow create, update`.
      //
      // Three ways to pass:
      //   1. profileStatus absent entirely (a doc that has never had one),
      //      allowed only if no reviewed identity field is being touched;
      //   2. 'incomplete', or 'pending' from any prior status — the
      //      submit / resubmit path, including an approved athlete
      //      re-submitting an edited profile, which correctly drops them
      //      back into the review queue;
      //   3. unchanged from its prior value AND touching no reviewed
      //      identity field — the sign-in upsert, which rewrites
      //      displayName / photoURL / email and nothing reviewable.
      function profileStatusTransitionAllowed() {
        return !('profileStatus' in request.resource.data)
          ? !touchesReviewedIdentity()
          : (request.resource.data.profileStatus == 'incomplete' ||
             request.resource.data.profileStatus == 'pending' ||
             (request.resource.data.profileStatus == priorProfileStatus() &&
              !touchesReviewedIdentity()));
      }

      // Admin-owned fields. An admin (or the admin-triggered recompute)
      // writes these through the Admin SDK, which bypasses rules
      // entirely; a client may never introduce, change, or erase them.
      // `stats` is the per-athlete PR/Ao5/solve-count rollup written by
      // lib/online-competition/athleteStats.ts — without it here a client
      // could set its own personal bests through the profile form, which
      // is a merge write and therefore carries the whole document.
      //
      // Requiring them to be ABSENT was wrong: every client write here is
      // a setDoc(..., { merge: true }), so request.resource.data is the
      // FULL resulting document and carries forward whatever the admin
      // last wrote. Comparing each field against its prior value locks
      // them down just as tightly while letting an untouched
      // carry-forward through.
      //
      // map.get(field, null) rather than an `in` test so all cases
      // collapse to one comparison: absent==absent passes, unchanged
      // passes, and introducing, changing OR erasing the field all fail.
      //
      // The approved* set records the identity an admin ACTUALLY reviewed,
      // so a later edit can never retroactively change what was approved.
      // approvedPhotoUrl has always done this for the photo; the name,
      // birth date, gender and citizenship now do the same.
      function judgeFieldsUntouched() {
        return resource == null
          ? (!('approvedPhotoUrl' in request.resource.data) &&
             !('approvedLastName' in request.resource.data) &&
             !('approvedFirstName' in request.resource.data) &&
             !('approvedDateOfBirth' in request.resource.data) &&
             !('approvedGender' in request.resource.data) &&
             !('approvedCitizenship' in request.resource.data) &&
             !('reviewedAt' in request.resource.data) &&
             !('rejectionReason' in request.resource.data) &&
             !('stats' in request.resource.data))
          : (request.resource.data.get('approvedPhotoUrl', null) == resource.data.get('approvedPhotoUrl', null) &&
             request.resource.data.get('approvedLastName', null) == resource.data.get('approvedLastName', null) &&
             request.resource.data.get('approvedFirstName', null) == resource.data.get('approvedFirstName', null) &&
             request.resource.data.get('approvedDateOfBirth', null) == resource.data.get('approvedDateOfBirth', null) &&
             request.resource.data.get('approvedGender', null) == resource.data.get('approvedGender', null) &&
             request.resource.data.get('approvedCitizenship', null) == resource.data.get('approvedCitizenship', null) &&
             request.resource.data.get('reviewedAt', null) == resource.data.get('reviewedAt', null) &&
             request.resource.data.get('rejectionReason', null) == resource.data.get('rejectionReason', null) &&
             request.resource.data.get('stats', null) == resource.data.get('stats', null));
      }

      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
                                request.auth.uid == uid &&
                                (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email) &&
                                (!('photoURL' in request.resource.data) || request.resource.data.photoURL == null || request.resource.data.photoURL is string) &&
                                (!('displayName' in request.resource.data) || request.resource.data.displayName is string) &&
                                (!('lastName' in request.resource.data) || request.resource.data.lastName is string) &&
                                (!('firstName' in request.resource.data) || request.resource.data.firstName is string) &&
                                (!('dateOfBirth' in request.resource.data) || request.resource.data.dateOfBirth is string) &&
                                (!('gender' in request.resource.data) || request.resource.data.gender in ['male', 'female', 'other']) &&
                                (!('citizenship' in request.resource.data) || request.resource.data.citizenship is string) &&
                                // Type-only, like its neighbours. wcaId is NOT in
                                // reviewedIdentityKeys() and has no approved* snapshot:
                                // a WCA id is public and independently checkable, so it
                                // needs no review machinery. Format is a UI concern.
                                (!('wcaId' in request.resource.data) || request.resource.data.wcaId is string) &&
                                (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null || request.resource.data.photoUrl is string) &&
                                (!('photoPublicId' in request.resource.data) || request.resource.data.photoPublicId == null || request.resource.data.photoPublicId is string) &&
                                profileStatusTransitionAllowed() &&
                                judgeFieldsUntouched();

      match /registrations/{competitionId} {
        // OWNER ONLY. This was `isSignedIn()` — any signed-in account could
        // read any athlete's registration, including the free-text note
        // whose placeholder asks for a contact phone number, and athlete
        // uids are public (the leaderboard documents are keyed by them).
        //
        // Nothing legitimate needs more: every client-side reader
        // (fetchRegistration, fetchMyRegistrations, and the transaction in
        // registerForCompetition) reads the signed-in athlete's own
        // documents, and the admin panel reads through API routes with the
        // Admin SDK, which bypasses these rules. isAdmin() is deliberately
        // NOT added — no client-side admin read exists to need it.
        allow read: if isSignedIn() && request.auth.uid == uid;
        // `note` — optional, a string of at most 300 characters. 300 is
        // REGISTRATION_NOTE_MAX in lib/online-competition/types.ts; rules
        // cannot import it, so change both together. This is the only
        // server-side validation a registration gets: the athlete's client
        // writes it directly, with no API route in between.
        allow create, update: if isSignedIn() &&
                                  request.auth.uid == uid &&
                                  request.resource.data.competitionId == competitionId &&
                                  request.resource.data.events is list &&
                                  request.resource.data.events.size() > 0 &&
                                  (!('note' in request.resource.data) ||
                                   (request.resource.data.note is string &&
                                    request.resource.data.note.size() <= 300));
        allow delete: if false;
      }
    }

    match /onlineSubmissions/{submissionId} {
      allow read: if isSignedIn() &&
                     (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() ||
                       (isSignedIn() &&
                        resource.data.uid == request.auth.uid &&
                        request.resource.data.uid == resource.data.uid &&
                        request.resource.data.status == resource.data.status &&
                        request.resource.data.penalty == resource.data.penalty);
      allow delete: if isAdmin();
    }

    // Per-athlete notification feed for the online-competition platform.
    // Written ONLY server-side, by the Admin SDK (the judge-decision route
    // app/api/online-competition/review/route.ts), which bypasses these
    // rules entirely — so `create` is denied to every client, matching how
    // onlineSubmissions.status/penalty are handled. The owner may read
    // their own notifications and flip nothing but the `read` flag.
    match /onlineNotifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn() &&
                       resource.data.uid == request.auth.uid &&
                       request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /onlineSeasonPoints/{season} {
      match /athletes/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}